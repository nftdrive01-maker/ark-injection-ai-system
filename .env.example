COMPOSE_PROJECT_NAME=ark-injection-ai-system

# ------------------------------------------------------------
# Amica basic settings
# Amica は localhost:${AMICA_PORT} で公開されます
# ここで設定した値は docker-compose.yml 経由で Amica コンテナに注入されます
# 環境変数を変更した後は docker compose up -d --force-recreate amica で反映してください
# ------------------------------------------------------------

# Amica のホスト公開ポート
AMICA_PORT=3000

# 使用する会話バックエンド
# 主な値: ollama / openai / koboldai など
# ark-injection-ai-system では基本的に ollama 運用を想定
# AMICA_CHATBOT_BACKEND=ollama
AMICA_CHATBOT_BACKEND=chatgpt

# チャット UI を初期表示するか
# true: 起動直後からチャット欄を表示
# false: 3D 表示を優先し、必要時にユーザーが開く
AMICA_DEFAULT_SHOW_CHAT_MODE=true

# Amica 側の設定 UI を表示するか
# injection-tool 側で設定を一元管理する場合は false を推奨
AMICA_SHOW_SETTINGS_UI=false

# true のときは、AI メッセージ表示を TTS 音声生成より先に進めます
# 音声が遅れてもテキストを即表示したい場合に有効化してください
# false にすると従来どおり、文表示は TTS 取得完了後のキュー処理に寄ります
AMICA_ASYNC_TTS_MODE=false

# 使用する TTS バックエンド
# 例: stylebertvits2 / piper / kokoro / openai_tts
# Piper に切り替える場合は AMICA_TTS_BACKEND=piper に変更してください
AMICA_TTS_BACKEND=stylebertvits2

# テキスト会話用 Ollama の接続先
# Docker Desktop 環境でホストの Ollama を使う場合は host.docker.internal を利用
# 別ホストで動かす場合は http://<host>:11434 の形式に変更
AMICA_OLLAMA_URL=http://host.docker.internal:11434

# injection-tool から見た Ollama の接続先
# WSL2 + Windows 版 Ollama.exe のように、injection-tool だけ別経路で疎通調整が必要な場合に変更
INJECTION_OLLAMA_URL=http://host.docker.internal:11434

# YouTubeライブ配信連携(専用OAuthクライアント)
# Google CloudでYouTube Data API v3を有効化、OAuthクライアント(ウェブ)を新設、
# 同意画面に youtube.readonly スコープを追加、下記リダイレクトURIを登録すること。
STREAMING_OAUTH_CLIENT_ID=
STREAMING_OAUTH_CLIENT_SECRET=
STREAMING_OAUTH_REDIRECT_URI=http://localhost:4001/api/streaming/oauth/callback

# テキスト会話用 Ollama モデル
# 例: qwen2.5:7b / gemma3:12b / mistral:7b
AMICA_OLLAMA_MODEL=qwen2.5:7b

# Amica から見た Piper の接続先
# 同一 compose 内の Piper コンテナを使う場合は http://piper:8000 を使います
AMICA_PIPER_URL=http://piper:8000

# 画像認識のバックエンド
# 主な値: vision_ollama / vision_openai / vision_llamacpp
# Ollama で一括管理する場合は vision_ollama を指定
AMICA_VISION_BACKEND=vision_ollama

# 画像認識用 Ollama の接続先
# 未分離運用なら AMICA_OLLAMA_URL と同じで問題ありません
# Vision 専用 Ollama サーバーを分けたい場合だけ別 URL にしてください
# WSL2からIPを確認するコマンド ip route | awk '/default/ {print $3}'


AMICA_VISION_OLLAMA_URL=http://host.docker.internal:11434

# 画像認識用 Ollama モデル
# 画像入力に対応したモデルが必要です
# 例: llava / minicpm-v / qwen2.5vl
AMICA_VISION_OLLAMA_MODEL=llava

# クライアント設定画面から変更させたくないキー一覧
# カンマ区切りで指定します
# ここに含めたキーは localStorage より環境変数が優先され、設定画面でも変更不可になります
# 運用上は backend / model / URL のような重要項目を固定する用途を想定
AMICA_MANAGED_CONFIG_KEYS=chatbot_backend,ollama_url,ollama_model,vision_backend,vision_ollama_url,vision_ollama_model,tts_backend,piper_url

# Amica 設定画面で非表示にしたいページ一覧
# カンマ区切りで指定します
# 例: chatbot,tts,stt,vision,developer,external_api
# 空欄なら全ページを表示
AMICA_HIDDEN_SETTINGS_PAGES=

# OpenAI を使う場合の API キー
# Ollama 運用のみなら空欄で構いません
# 実運用の秘密情報は .env に設定し、.env.example には書かないでください
AMICA_OPENAI_APIKEY=replace-with-your-openai-api-key

# OpenAI 互換 API のベース URL
# OpenAI 公式ならそのまま、OpenAI 互換サーバーを使う場合はその URL に変更
AMICA_OPENAI_URL=https://api.openai.com

# OpenAI 利用時のモデル名
AMICA_OPENAI_MODEL=gpt-4o-mini

# injection-tool のホスト公開ポート
INJECTION_TOOL_PORT=4001

# injection-tool 管理画面のログイン情報
# 公開環境では必ず変更してください
INJECTION_ADMIN_USERNAME=admin
INJECTION_ADMIN_PASSWORD=change_me

# injection-tool のセッション署名鍵
# 公開運用では十分に長いランダム文字列へ変更してください
INJECTION_SESSION_SECRET=change_me_to_a_long_random_secret

# mcp-server のホスト公開ポート
MCP_SERVER_PORT=8000

# SBV2 のホスト公開ポート
SBV2_PORT=5000

# Piper のホスト公開ポート
# ローカル検証では http://localhost:${PIPER_PORT} で直接疎通確認できます
PIPER_PORT=5001

# Piper が利用する音声モデル URL
# 音声モデルは配布元ライセンスを確認のうえ、利用者が別途設定してください
PIPER_MODEL_URL=

# Piper モデルに対応する config.json
# 上記モデル URL に対応する config を設定してください
PIPER_CONFIG_URL=

# 選択した音声モデルに合わせて既定言語を設定してください
PIPER_DEFAULT_LANGUAGE=ja

# Piper 推論デバイス
# CPU 運用なら cpu、GPU を使うなら gpu を指定します
PIPER_DEVICE=cpu

# 発話速度の調整値
# 値を大きくするとゆっくり、小さくすると速くなります
# まずは 1.2 - 1.5 あたりで調整するのが扱いやすいです
PIPER_LENGTH_SCALE=1.0

# 音声のゆらぎ調整
# 通常は既定値のままで構いません
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# ------------------------------------------------------------
# e-Stat MCP settings
# e-Stat MCP は政府統計の総合窓口(e-Stat) API を利用するMCPサーバーです
# injection-tool からは http://estat-mcp:8000/sse で接続されます
# ------------------------------------------------------------

# e-Stat MCP のホスト公開ポート
ESTAT_MCP_PORT=8002

# e-Stat API の appId
# https://www.e-stat.go.jp/api/api-info/use-api で取得してください
# 未設定だと e-Stat MCP は API 呼び出しに失敗します
ESTAT_APP_ID=

# Google Workspace MCP のホスト公開ポート
GOOGLE_WORKSPACE_MCP_PORT=8001

# Cloudflare 外部公開 URL（Cloudflare Tunnel 使用時に設定）
# 例: CLOUDFLARE_EXTERNAL_URL=https://xxxx.trycloudflare.com
# 外部公開を使わないローカル運用では未設定で構いません
# CLOUDFLARE_EXTERNAL_URL=

# Google Workspace MCP OAuth credentials
# Google Workspace MCP を使う場合に設定してください
# 使わない場合は空欄のままで構いません
# 実値や取得済み token は Git に含めず、環境ごとに別管理してください
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------
# SBV2 container settings
# SBV2 は Compose サービスとして常時コンテナ運用します
# cpu / cuda を切り替える場合だけ SBV2_DEVICE を変更してください
# 推論に必要な model_assets / bert は別途配置が必要です
SBV2_DEVICE=cpu

# ------------------------------------------------------------
# DBHub (MCP Database Gateway) settings
# DBHub は PostgreSQL へのMCPアクセスを提供するゲートウェイです
# ホストからは http://localhost:${DBHUB_PORT} でアクセスできます
# 主に MCP 経由でデータベース内容を参照・操作する用途を想定しています
# ------------------------------------------------------------

# DBHub のホスト公開ポート
# 8080 が競合する場合は別ポートに変更してください
DBHUB_PORT=8080

# DBHub が返す最大行数
# 大量データを扱うクエリの際に適宜調整してください
DBHUB_MAX_ROWS=9999
# ------------------------------------------------------------
# PostgreSQL (database) settings
# DBHub および他サービスから ark-database:5432 で接続されます
# injection-tool などが利用する永続データの保存先です
# ------------------------------------------------------------

# PostgreSQL ログインユーザー名
# ローカル検証では既定値でも動きますが、共有環境では変更を推奨
DB_USER=user

# PostgreSQL ログインパスワード（本番環境では必ず変更してください）
# .env.example には例示値のみを置き、実運用値は .env で管理してください
DB_PASSWORD=password

# 使用するデータベース名
# 初期作成されるデータベース名です
DB_NAME=dbname
